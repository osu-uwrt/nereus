{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed robot pack",
  "description": "Step 1 proposal, not implemented runtime support; generated-from-loader schemas and lossless load/save are step 2+. Robot data only: no ROS names, tasks or code. Frame/asset/mechanism id references and thruster/scale lengths are semantic checks.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "robot"},
    "id": {"$ref": "common.schema.json#/$defs/name"},
    "description": {"type": "string"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "assets": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/asset"}},
    "reference_frame": {
      "$ref": "common.schema.json#/$defs/name",
      "description": "Frame reported as the vehicle pose to tasks, bridge and placement."
    },
    "body": {
      "type": "object",
      "properties": {
        "type": {"const": "marine_6dof"},
        "parameters": {"$ref": "types.schema.json#/$defs/marine_6dof"}
      },
      "required": ["type", "parameters"],
      "additionalProperties": false
    },
    "frames": {"$ref": "common.schema.json#/$defs/frames"},
    "collision_boxes": {
      "type": "array",
      "items": {"$ref": "common.schema.json#/$defs/collision_box"},
      "description": "Robot contact proxies expressed in the frames root (COM)."
    },
    "thrusters": {"type": "array", "items": {"$ref": "#/$defs/thruster"}, "minItems": 1},
    "safety": {"$ref": "#/$defs/safety"},
    "sensors": {"type": "array", "items": {"$ref": "#/$defs/sensor"}},
    "mechanisms": {"type": "array", "items": {"$ref": "#/$defs/mechanism"}},
    "scoring_envelope": {"$ref": "#/$defs/scoring_envelope"},
    "pending": {"$ref": "common.schema.json#/$defs/pending"}
  },
  "required": ["schema_version", "kind", "id", "assets", "reference_frame", "body", "frames",
               "collision_boxes", "thrusters", "safety", "sensors", "mechanisms", "scoring_envelope"],
  "additionalProperties": false,
  "$defs": {
    "thruster": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/name"},
        "type": {"const": "lagged_force"},
        "position_m": {"$ref": "common.schema.json#/$defs/vector3", "description": "COM-relative."},
        "direction": {"$ref": "common.schema.json#/$defs/vector3", "description": "Unit thrust axis, body frame (norm is a semantic check)."},
        "parameters": {"$ref": "types.schema.json#/$defs/lagged_force"}
      },
      "required": ["id", "type", "position_m", "direction", "parameters"],
      "additionalProperties": false,
      "description": "List order is the native actuator index; ROS array order is bridge-owned."
    },
    "safety": {
      "type": "object",
      "properties": {
        "initially_killed": {"type": "boolean"},
        "kill_stops_thrusters": {"type": "boolean"},
        "commands_while_killed": {"enum": ["zero_force", "rejected"]},
        "kill_disarms_mechanisms": {"type": "boolean"},
        "arming": {
          "type": "object",
          "properties": {
            "initially_armed": {"type": "boolean"},
            "arm_rejected_while_killed": {"type": "boolean"},
            "applies_to": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/name"}, "uniqueItems": true}
          },
          "required": ["initially_armed", "arm_rejected_while_killed", "applies_to"],
          "additionalProperties": false
        }
      },
      "required": ["initially_killed", "kill_stops_thrusters", "commands_while_killed", "kill_disarms_mechanisms", "arming"],
      "additionalProperties": false,
      "description": "Robot-owned kill/arming semantics; transports only map commands onto them."
    },
    "sensor": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/name"},
        "type": {"enum": ["imu", "attitude", "ahrs", "fog", "dvl", "reference_velocity", "reference_altitude", "pressure", "stereo_camera"]},
        "frame": {"$ref": "common.schema.json#/$defs/name", "description": "Reporting frame (robot frame or world)."},
        "mount_frame": {"$ref": "common.schema.json#/$defs/name"},
        "period_ns": {"type": "integer", "minimum": 1},
        "latency_ns": {"type": "integer", "minimum": 0},
        "capacity": {"type": "integer", "minimum": 1},
        "overflow": {"enum": ["fail", "drop_oldest"]},
        "enabled": {"type": "boolean"},
        "parameters": {"type": "object"}
      },
      "required": ["id", "type", "frame", "mount_frame", "period_ns", "parameters"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "imu"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/imu"}}}},
        {"if": {"properties": {"type": {"const": "attitude"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/attitude"}}}},
        {"if": {"properties": {"type": {"const": "ahrs"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/ahrs"}}}},
        {"if": {"properties": {"type": {"const": "fog"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/fog"}}}},
        {"if": {"properties": {"type": {"const": "dvl"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/dvl"}}}},
        {"if": {"properties": {"type": {"const": "reference_velocity"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/reference_velocity"}}}},
        {"if": {"properties": {"type": {"const": "reference_altitude"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/reference_altitude"}}}},
        {"if": {"properties": {"type": {"const": "pressure"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/pressure"}}}},
        {"if": {"properties": {"type": {"const": "stereo_camera"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/stereo_camera"}}}}
      ],
      "description": "Active sensor instance; parameters are validated by the per-type definition selected by type."
    },
    "mechanism": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/name"},
        "type": {"enum": ["launcher", "dropper", "claw", "magnet"]},
        "frame": {"$ref": "common.schema.json#/$defs/name"},
        "parameters": {"type": "object"}
      },
      "required": ["id", "type", "frame", "parameters"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "launcher"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/launcher"}}}},
        {"if": {"properties": {"type": {"const": "dropper"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/dropper"}}}},
        {"if": {"properties": {"type": {"const": "claw"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/claw"}}}},
        {"if": {"properties": {"type": {"const": "magnet"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/magnet"}}}}
      ]
    },
    "scoring_envelope": {
      "type": "object",
      "properties": {
        "collision_boxes": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/name"}, "minItems": 1, "uniqueItems": true},
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {"$ref": "common.schema.json#/$defs/name"},
              "frame": {"$ref": "common.schema.json#/$defs/name"},
              "position_m": {"$ref": "common.schema.json#/$defs/vector3"}
            },
            "required": ["id", "frame", "position_m"],
            "additionalProperties": false
          }
        }
      },
      "required": ["collision_boxes", "points"],
      "additionalProperties": false,
      "description": "Vertices tasks use for pass-through/breach tests: all 8 corners of each listed collision box plus points."
    }
  }
}
