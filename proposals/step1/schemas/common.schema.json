{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed shared pack values",
  "description": "Step 1 proposal only. Not an implemented loader or generated runtime catalog; loader-owned definitions generate published schemas from step 2. Cross-document references (frame names, asset ids, mechanism ids, task ids) are semantic checks, not JSON Schema checks.",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 128,
      "description": "Identifier for ids and native frame names; no path separators or spaces."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:).+$",
      "description": "Pack-root-relative resource path. Resolve inside the selected pack, never via ROS package paths, URLs or environment variables."
    },
    "pack_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:).+$",
      "description": "Scenario-folder-relative path selecting another pack folder. Parent segments are permitted only for these selections."
    },
    "vector3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "nonnegative_vector3": {
      "type": "array",
      "items": {"type": "number", "minimum": 0},
      "minItems": 3,
      "maxItems": 3
    },
    "positive_vector3": {
      "type": "array",
      "items": {"type": "number", "exclusiveMinimum": 0},
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": {"type": "number", "minimum": -1, "maximum": 1},
      "minItems": 4,
      "maxItems": 4,
      "description": "Child-to-parent unit quaternion, w,x,y,z order. Semantic validation checks the norm."
    },
    "matrix3": {
      "type": "array",
      "items": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
      "minItems": 3,
      "maxItems": 3
    },
    "matrix6": {
      "type": "array",
      "items": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
      "minItems": 6,
      "maxItems": 6
    },
    "pose": {
      "type": "object",
      "properties": {
        "position_m": {"$ref": "#/$defs/vector3"},
        "orientation_wxyz": {"$ref": "#/$defs/quaternion"}
      },
      "required": ["position_m", "orientation_wxyz"],
      "additionalProperties": false
    },
    "named_pose": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "position_m": {"$ref": "#/$defs/vector3"},
        "orientation_wxyz": {"$ref": "#/$defs/quaternion"}
      },
      "required": ["id", "position_m", "orientation_wxyz"],
      "additionalProperties": false,
      "description": "Named frame fixed in the enclosing task-local frame."
    },
    "yaw_deg": {
      "type": "number",
      "exclusiveMinimum": -360,
      "exclusiveMaximum": 360,
      "description": "Rotation about world +Z in degrees, stored as in the source to avoid hand-rounded radians."
    },
    "upright_placement": {
      "type": "object",
      "properties": {
        "position_m": {"$ref": "#/$defs/vector3"},
        "yaw_deg": {"$ref": "#/$defs/yaw_deg"}
      },
      "required": ["position_m", "yaw_deg"],
      "additionalProperties": false,
      "description": "Upright scenario placement in the world frame (yaw only), as used by the native world placement."
    },
    "frame": {
      "type": "object",
      "properties": {
        "parent": {"$ref": "#/$defs/name"},
        "child": {"$ref": "#/$defs/name"},
        "position_m": {"$ref": "#/$defs/vector3"},
        "orientation_wxyz": {"$ref": "#/$defs/quaternion"}
      },
      "required": ["parent", "child", "position_m", "orientation_wxyz"],
      "additionalProperties": false
    },
    "frames": {
      "type": "object",
      "properties": {
        "root": {"$ref": "#/$defs/name"},
        "transforms": {"type": "array", "items": {"$ref": "#/$defs/frame"}, "maxItems": 128}
      },
      "required": ["root", "transforms"],
      "additionalProperties": false,
      "description": "One parent per frame, no cycles; all frames resolve to the root. ROS names and TF ownership belong to the bridge."
    },
    "collision_box": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "size_m": {"$ref": "#/$defs/positive_vector3"},
        "center_m": {"$ref": "#/$defs/vector3"},
        "orientation_wxyz": {"$ref": "#/$defs/quaternion"}
      },
      "required": ["id", "size_m", "center_m", "orientation_wxyz"],
      "additionalProperties": false,
      "description": "Box in the owning document's root frame (robot COM, pool-local, or task-local)."
    },
    "noise3": {
      "type": "object",
      "properties": {
        "bias": {"$ref": "#/$defs/vector3"},
        "white_stddev": {"$ref": "#/$defs/nonnegative_vector3"},
        "walk_stddev": {"$ref": "#/$defs/nonnegative_vector3"}
      },
      "additionalProperties": false
    },
    "noise1": {
      "type": "object",
      "properties": {
        "bias": {"type": "number"},
        "white_stddev": {"type": "number", "minimum": 0},
        "walk_stddev": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "source_file": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "hash_basis": {
          "enum": ["git_revision", "worktree"],
          "description": "git_revision: hashed from the pinned Git object (worktree matched on worktree_checked). worktree: hashed from the working tree only; equality to the pinned revision unverified."
        }
      },
      "required": ["path", "sha256", "hash_basis"],
      "additionalProperties": false,
      "description": "Workspace-relative original source (repository-name prefixed)."
    },
    "derived_file": {
      "type": "object",
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "description": "robotics_platform repository file whose verified values this document copies."
    },
    "provenance": {
      "type": "object",
      "properties": {
        "revisions": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/name"},
          "additionalProperties": {"$ref": "#/$defs/git_revision"},
          "minProperties": 1
        },
        "worktree_checked": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source_file"}, "minItems": 1},
        "derived_from": {"type": "array", "items": {"$ref": "#/$defs/derived_file"}},
        "parameter_status": {"enum": ["unvalidated_prior", "measured", "specification"]}
      },
      "minProperties": 1,
      "additionalProperties": false,
      "description": "Optional non-executable source identity retained in load/save and the resolved manifest. User-authored packs need no Git repository: every key is optional, but supplied data is strictly typed."
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "path": {"$ref": "#/$defs/path"},
        "source": {"type": "string", "minLength": 1, "maxLength": 256},
        "sha256": {"$ref": "#/$defs/sha256"},
        "required_from_step": {"$ref": "#/$defs/step"},
        "status": {
          "enum": ["missing", "present"],
          "description": "missing: declared for a later step, no file copied yet. A loader must reject a missing asset once its required_from_step is active."
        }
      },
      "required": ["id", "path", "source", "required_from_step", "status"],
      "additionalProperties": false,
      "if": {"properties": {"status": {"const": "present"}}},
      "then": {"required": ["sha256"]},
      "description": "source is provenance text, never a runtime fallback path."
    },
    "qos": {
      "type": "object",
      "properties": {
        "history": {"const": "keep_last"},
        "depth": {"type": "integer", "minimum": 1},
        "reliability": {"enum": ["reliable", "best_effort"]},
        "durability": {"enum": ["volatile", "transient_local"]}
      },
      "required": ["history", "depth", "reliability", "durability"],
      "additionalProperties": false
    },
    "pending_item": {
      "type": "object",
      "properties": {
        "id": {"$ref": "#/$defs/name"},
        "category": {"enum": ["sensor", "mechanism", "task", "task_placement", "bridge_stream"]},
        "proposed_type": {"$ref": "#/$defs/name"},
        "required_from_step": {"$ref": "#/$defs/step"},
        "blocker": {"type": "string", "minLength": 1},
        "known": {
          "type": "object",
          "description": "Source facts recorded for the later step. Inactive data: never instantiated, validated only when promoted into the typed active section."
        }
      },
      "required": ["id", "category", "required_from_step", "blocker", "known"],
      "additionalProperties": false,
      "description": "Inactive future item. Active configuration must never depend on it."
    },
    "pending": {
      "type": "array",
      "items": {"$ref": "#/$defs/pending_item"}
    }
  }
}
