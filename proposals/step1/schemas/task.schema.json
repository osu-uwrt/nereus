{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed task include file",
  "description": "Step 1 proposal; generated-from-loader schemas are step 2+. One task definition in its own task-local frame, composed from generic built-in props, regions, events and declarative scoring. No task, robot or year specific types. Id references (region, prop, asset, frame) are semantic checks.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "task"},
    "id": {"$ref": "common.schema.json#/$defs/name"},
    "description": {"type": "string"},
    "frames": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/named_pose"}},
    "props": {"type": "array", "items": {"$ref": "#/$defs/prop"}},
    "regions": {"type": "array", "items": {"$ref": "#/$defs/region"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "scoring": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/name"},
          "type": {"const": "event_points"},
          "parameters": {"$ref": "types.schema.json#/$defs/event_points"}
        },
        "required": ["id", "type", "parameters"],
        "additionalProperties": false
      },
      "description": "Declarative points; stateful rules belong to the pack scoring hook."
    }
  },
  "required": ["schema_version", "kind", "id", "frames", "props", "regions", "events", "scoring"],
  "additionalProperties": false,
  "$defs": {
    "prop": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/name"},
        "type": {"enum": ["static_body"]},
        "parameters": {"$ref": "types.schema.json#/$defs/static_body"}
      },
      "required": ["id", "type", "parameters"],
      "additionalProperties": false,
      "description": "rigid_body is added with its first step-4 instance."
    },
    "region": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/name"},
        "type": {"enum": ["rectangular_portal", "perforated_panel"]},
        "parameters": {"type": "object"}
      },
      "required": ["id", "type", "parameters"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "rectangular_portal"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/rectangular_portal"}}}},
        {"if": {"properties": {"type": {"const": "perforated_panel"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/perforated_panel"}}}}
      ],
      "description": "box and surface regions are added with their first step-4 instance."
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/name"},
        "type": {"enum": ["pass_through", "contact", "hit"]},
        "parameters": {"type": "object"}
      },
      "required": ["id", "type", "parameters"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "pass_through"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/pass_through"}}}},
        {"if": {"properties": {"type": {"const": "contact"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/contact"}}}},
        {"if": {"properties": {"type": {"const": "hit"}}}, "then": {"properties": {"parameters": {"$ref": "types.schema.json#/$defs/hit"}}}}
      ],
      "description": "drop_into, attach, surface and timeout are added with their first step-4 instance."
    }
  }
}
