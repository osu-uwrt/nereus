{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed tasks pack",
  "description": "Step 1 proposal, not implemented runtime support; generated-from-loader schemas are step 2+. Task pack root: task include files, capability requirements, run options and scoring hooks. No layout (scenario-owned) and no robot ids. validate never imports hooks.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "tasks"},
    "id": {"$ref": "common.schema.json#/$defs/name"},
    "description": {"type": "string"},
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "assets": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/asset"}},
    "tasks": {
      "type": "array",
      "items": {"allOf": [{"$ref": "common.schema.json#/$defs/path"}, {"pattern": "\\.yaml$"}]},
      "minItems": 1,
      "uniqueItems": true,
      "description": "Pack-relative task include files, each a kind: task document (task.schema.json)."
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {"$ref": "common.schema.json#/$defs/name"},
          "mechanism_type": {"enum": ["launcher", "dropper", "claw", "magnet"]},
          "min_count": {"type": "integer", "minimum": 1}
        },
        "required": ["task", "mechanism_type", "min_count"],
        "additionalProperties": false
      },
      "description": "Capability requirements by mechanism type, checked against the selected robot; never by robot id."
    },
    "run_options": {"type": "array", "items": {"$ref": "#/$defs/run_option"}},
    "scoring_hooks": {"type": "array", "items": {"$ref": "#/$defs/scoring_hook"}},
    "pending": {"$ref": "common.schema.json#/$defs/pending"}
  },
  "required": ["schema_version", "kind", "id", "assets", "tasks", "requires", "run_options", "scoring_hooks"],
  "additionalProperties": false,
  "$defs": {
    "run_option": {
      "type": "object",
      "properties": {
        "key": {"$ref": "common.schema.json#/$defs/name"},
        "type": {"enum": ["choice", "bool"]},
        "choices": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/name"}, "minItems": 2, "uniqueItems": true},
        "default": {"type": ["string", "boolean"]}
      },
      "required": ["key", "type", "default"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"type": {"const": "choice"}}},
         "then": {"required": ["choices"], "properties": {"default": {"type": "string"}}},
         "else": {"not": {"required": ["choices"]}, "properties": {"default": {"type": "boolean"}}}}
      ],
      "description": "Scenario-selectable option; a choice default must be one of choices (semantic check)."
    },
    "scoring_hook": {
      "type": "object",
      "properties": {
        "module": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$", "description": "Dotted module resolved only inside this task pack."},
        "function": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "parameters": {"type": "object", "description": "Hook-declared data passed verbatim; the hook owns its own parameter validation."}
      },
      "required": ["module", "function", "parameters"],
      "additionalProperties": false,
      "description": "Task-pack-owned Python only: immutable state and newly committed events in, score changes and new events out; no runtime object, stepping or ROS. Robot, pool, sensor and bridge packs cannot declare hooks."
    }
  }
}
