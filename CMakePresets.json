{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "asan",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "NEREUS_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "plant-only",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/plant-only",
      "cacheVariables": {
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "ros-viewer",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/ros-viewer",
      "cacheVariables": {
        "NEREUS_BUILD_SCENE_RENDERER": "ON",
        "NEREUS_BUILD_ROS_VIEWER": "ON",
        "NEREUS_BUILD_MESH_ASSETS": "ON",
        "BUILD_TESTING": "ON",
        "NEREUS_BUILD_SIMULATION": "ON",
        "NEREUS_BUILD_SESSION": "ON",
        "NEREUS_BUILD_PACK_SCENE": "ON",
        "NEREUS_BUILD_SESSION_CAMERAS": "ON",
        "NEREUS_BUILD_ROS_BRIDGE": "ON",
        "NEREUS_BUILD_CAMERAS": "ON",
        "NEREUS_BUILD_OFFSCREEN_RENDERER": "ON",
        "NEREUS_BUILD_DATASETS": "ON"
      }
    },
    {
      "name": "session",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/session",
      "cacheVariables": {
        "NEREUS_BUILD_SESSION": "ON",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "datasets",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/datasets",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "NEREUS_BUILD_SIMULATION": "ON",
        "NEREUS_BUILD_SCENE_RENDERER": "ON",
        "NEREUS_BUILD_OFFSCREEN_RENDERER": "ON",
        "NEREUS_BUILD_MESH_ASSETS": "ON",
        "NEREUS_BUILD_CAMERAS": "ON",
        "NEREUS_BUILD_SESSION": "ON",
        "NEREUS_BUILD_PACK_SCENE": "ON",
        "NEREUS_BUILD_DATASETS": "ON",
        "NEREUS_BUILD_ROS_BRIDGE": "OFF",
        "NEREUS_BUILD_ROS_VIEWER": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "jobs": 2
    },
    {
      "name": "plant-only",
      "configurePreset": "plant-only",
      "jobs": 2
    },
    {
      "name": "ros-viewer",
      "configurePreset": "ros-viewer",
      "jobs": 3
    },
    {
      "name": "datasets",
      "configurePreset": "datasets",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
