 "bridge": {
  "kind": "bridge",
  "id": "uwrt_talos",
  "description": "Talos <-> UWRT robot stack (controller, EKF, acoustics, perception, autonomy).",
  "requires_robot": "talos",
  "namespace": "/talos",
  "node_name": "physics_simulator",
  "frame_names": {
   "world": "map",
   "imu_mount": "talos/imu_link",
   "fog_mount": "talos/fog_link",
   "dvl_mount": "talos/dvl_link",
   "ffc_mount": "talos/ffc_camera_link",
   "dfc_mount": "talos/dfc_camera_link",
   "ffc_left_optical": "talos/ffc_left_camera_optical_frame",
   "ffc_right_optical": "talos/ffc_right_camera_optical_frame",
   "dfc_left_optical": "talos/dfc_left_camera_optical_frame",
   "dfc_right_optical": "talos/dfc_right_camera_optical_frame"
  },
  "clock": {
   "topic": "/clock",
   "epoch": "system_time_at_start",
   "rate_hz": 500,
   "reset_policy": "preserve_ros_epoch_and_time",
   "real_time_factor": 1.0,
   "qos": {
    "history": "keep_last",
    "depth": 10,
    "reliability": "reliable",
    "durability": "volatile"
   }
  },
  "thrusters": {
   "order": [
    "VUS",
    "VUP",
    "HUS",
    "HUP",
    "HLS",
    "HLP",
    "VLS",
    "VLP"
   ],
   "input_scales": [
    1,
    1,
    1,
    1,
    1,
    1,
    1,
    1
   ],
   "reject": [
    "wrong_length",
    "nonfinite"
   ]
  },
  "tf": {
   "publish": [
    {
     "parent": "map",
     "child": "simulator/talos/base_link",
     "native": "state:robot.reference_pose",
     "rate_hz": 100
    }
   ],
   "static": [
    {
     "parent": "talos/ffc_camera_link",
     "child": "talos/ffc_left_camera_optical_frame",
     "from_frame": "ffc_mount",
     "to_frame": "ffc_left_optical"
    },
    {
     "parent": "talos/ffc_left_camera_optical_frame",
     "child": "talos/ffc_right_camera_optical_frame",
     "from_frame": "ffc_left_optical",
     "to_frame": "ffc_right_optical"
    },
    {
     "parent": "talos/dfc_camera_link",
     "child": "talos/dfc_left_camera_optical_frame",
     "from_frame": "dfc_mount",
     "to_frame": "dfc_left_optical"
    },
    {
     "parent": "talos/dfc_left_camera_optical_frame",
     "child": "talos/dfc_right_camera_optical_frame",
     "from_frame": "dfc_left_optical",
     "to_frame": "dfc_right_optical"
    },
    {
     "parent": "simulator/talos/base_link",
     "child": "simulator/talos/origin",
     "from_frame": "base_link",
     "to_frame": "origin",
     "truth": true
    },
    {
     "parent": "simulator/talos/base_link",
     "child": "simulator/talos/ffc_camera_link",
     "from_frame": "base_link",
     "to_frame": "ffc_mount",
     "truth": true
    },
    {
     "parent": "simulator/talos/ffc_camera_link",
     "child": "simulator/talos/ffc_left_camera_optical_frame",
     "from_frame": "ffc_mount",
     "to_frame": "ffc_left_optical",
     "truth": true
    },
    {
     "parent": "simulator/talos/base_link",
     "child": "simulator/talos/dfc_camera_link",
     "from_frame": "base_link",
     "to_frame": "dfc_mount",
     "truth": true
    },
    {
     "parent": "simulator/talos/dfc_camera_link",
     "child": "simulator/talos/dfc_left_camera_optical_frame",
     "from_frame": "dfc_mount",
     "to_frame": "dfc_left_optical",
     "truth": true
    }
   ],
   "lookup": [
    {
     "parent": "world",
     "child": "map"
    },
    {
     "parent": "world",
     "child": "odom"
    }
   ],
   "never_publish": [
    "talos/base_link",
    "talos/imu_link",
    "talos/fog_link",
    "talos/dvl_link",
    "talos/ffc_camera_link",
    "talos/dfc_camera_link",
    "world",
    "odom",
    "map"
   ]
  },
  "kill": {
   "command_stream": "software_kill",
   "state_stream": "firmware_kill"
  },
  "reset": {
   "robot_service": "reset_sim_to_start",
   "tasks_service": "reset_tasks",
   "full_service": "reset_scenario"
  },
  "placement": {
   "set_service": "set_sim_pose",
   "sync_service": "sync_sim_to_estimate",
   "estimator_alignment": {
    "client": "/talos/set_pose",
    "service_type": "robot_localization/srv/SetPose",
    "triggers": [
     "startup",
     "placement",
     "reset_to_start",
     "full_reset"
    ],
    "estimate_stream": "ekf_odometry",
    "pose": "reference_frame",
    "covariance_diagonal": 1e-06
   }
  },
  "streams": [
   {
    "id": "thruster_forces",
    "direction": "subscribe",
    "topic": "thruster_forces",
    "message_type": "std_msgs/msg/Float32MultiArray",
    "native": "command:thrusters.set_forces",
    "frame_id": "",
    "rate_hz": 0,
    "qos": {
     "history": "keep_last",
     "depth": 10,
     "reliability": "reliable",
     "durability": "volatile"
    },
    "fields": {
     "forces_n": {
      "from": "data"
     }
    }
   },
   {
    "id": "software_kill",
    "direction": "subscribe",
    "topic": "command/software_kill",
    "message_type": "riptide_msgs2/msg/KillSwitchReport",
    "native": "command:robot.set_killed",
    "frame_id": "",
    "rate_hz": 0,
    "qos": {
     "history": "keep_last",
     "depth": 10,
     "reliability": "reliable",
     "durability": "volatile"
    },
    "accept_if": [
     {
      "field": "kill_switch_id",
      "equals": 1
     }
    ],
    "fields": {
     "killed": {
      "from": "switch_asserting_kill"
     }
    }
   },
   {
    "id": "ekf_odometry",
    "direction": "subscribe",
    "topic": "odometry/filtered",
    "message_type": "nav_msgs/msg/Odometry",
    "native": "estimate:latest",
    "frame_id": "",
    "rate_hz": 0,
    "qos": {
     "history": "keep_last",
     "depth": 10,
     "reliability": "reliable",
     "durability": "volatile"
    },
    "fields": {
     "frame": {
