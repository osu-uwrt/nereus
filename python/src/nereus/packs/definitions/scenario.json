{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scenario pack",
  "description": "Authoritative loader definition: published JSON Schemas and the type registry are generated from this corpus. Selects sibling robot/pool/tasks/bridge pack folders and owns world frame, placements, initial state, seed and run options. Task ids, run option keys/values and world-frame use are semantic checks against the selected packs.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "scenario"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "description": {
      "type": "string"
    },
    "robot": {
      "$ref": "common.schema.json#/$defs/pack_path"
    },
    "pool": {
      "$ref": "common.schema.json#/$defs/pack_path"
    },
    "tasks": {
      "$ref": "common.schema.json#/$defs/pack_path"
    },
    "bridge": {
      "$ref": "common.schema.json#/$defs/pack_path",
      "description": "Optional: headless runs omit the bridge."
    },
    "equipment": {
      "$ref": "common.schema.json#/$defs/pack_path",
      "description": "Optional: an equipment pack (the team's gear, placed by equipment_placements)."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "timestep_s": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 0.1,
      "description": "Fixed physics step in seconds, at most 100 ms; enabled sensors may not sample faster than one step (semantic check)."
    },
    "sensor_noise": {
      "type": "boolean"
    },
    "world_frame": {
      "$ref": "common.schema.json#/$defs/name",
      "description": "World frame id: ENU, +Z up, z = 0 at the water surface."
    },
    "world_placement": {
      "$ref": "common.schema.json#/$defs/upright_placement",
      "description": "Optional: the world frame placed in another scenario frame (e.g. the map origin your stack derives from a calibration tag). Replaces pool_placement: the pool becomes the root."
    },
    "pool_placement": {
      "$ref": "common.schema.json#/$defs/upright_placement",
      "description": "Pool-local frame in the world. Omit it to make the pool the root that world_placement hangs from."
    },
    "task_placements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "relative_to": {
            "$ref": "common.schema.json#/$defs/frame_ref",
            "description": "Default world."
          },
          "position_m": {
            "$ref": "common.schema.json#/$defs/vector3"
          },
          "yaw_deg": {
            "$ref": "common.schema.json#/$defs/yaw_deg"
          },
          "rpy_deg": {
            "$ref": "common.schema.json#/$defs/rpy_deg"
          }
        },
        "required": [
          "task",
          "position_m"
        ],
        "additionalProperties": false
      }
    },
    "task_frames": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "frame": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "position_m": {
            "$ref": "common.schema.json#/$defs/vector3"
          },
          "yaw_deg": {
            "$ref": "common.schema.json#/$defs/yaw_deg"
          }
        },
        "required": [
          "task",
          "frame",
          "position_m",
          "yaw_deg"
        ],
        "additionalProperties": false
      },
      "description": "Where this scenario puts a task's loose objects: a task frame that carries a rigid_body prop, moved to this pose in the task's local frame (upright: yaw about the task's +Z). Applied when resolving (semantic check)."
    },
    "equipment_placements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/name",
            "description": "Frame name of this placement; default the item id."
          },
          "item": {
            "$ref": "common.schema.json#/$defs/name",
            "description": "Item of the selected equipment pack."
          },
          "relative_to": {
            "$ref": "common.schema.json#/$defs/frame_ref",
            "description": "Default world."
          },
          "position_m": {
            "$ref": "common.schema.json#/$defs/vector3"
          },
          "yaw_deg": {
            "$ref": "common.schema.json#/$defs/yaw_deg"
          },
          "rpy_deg": {
            "$ref": "common.schema.json#/$defs/rpy_deg"
          }
        },
        "required": [
          "item",
          "position_m"
        ],
        "additionalProperties": false
      },
      "description": "Equipment items set up for this run; each is a frame others may be placed relative to."
    },
    "contacts": {
      "type": "object",
      "properties": {
        "model": {
          "enum": [
            "disabled",
            "sphere_pool",
            "box_scene"
          ]
        },
        "restitution": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "friction": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "model",
        "restitution",
        "friction"
      ],
      "additionalProperties": false
    },
    "initial": {
      "type": "object",
      "properties": {
        "relative_to": {
          "$ref": "common.schema.json#/$defs/frame_ref",
          "description": "Frame the start pose is measured in; default world."
        },
        "frame": {
          "$ref": "common.schema.json#/$defs/name",
          "description": "Robot frame whose world pose is given (native state frame: com)."
        },
        "position_m": {
          "$ref": "common.schema.json#/$defs/vector3"
        },
        "orientation_wxyz": {
          "$ref": "common.schema.json#/$defs/quaternion"
        },
        "linear_velocity_m_s": {
          "$ref": "common.schema.json#/$defs/vector3",
          "description": "Body axes."
        },
        "angular_velocity_rad_s": {
          "$ref": "common.schema.json#/$defs/vector3",
          "description": "Body axes."
        }
      },
      "required": [
        "frame",
        "position_m",
        "orientation_wxyz",
        "linear_velocity_m_s",
        "angular_velocity_rad_s"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "auto_start": {
          "type": "boolean"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "additionalProperties": {
            "type": [
              "string",
              "boolean"
            ]
          },
          "description": "Values for the selected task pack's run_options (semantic check)."
        }
      },
      "required": [
        "auto_start",
        "options"
      ],
      "additionalProperties": false
    },
    "thruster_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "thrusters": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/name"
            },
            "minItems": 1,
            "uniqueItems": true,
            "description": "Robot thruster ids; default every thruster."
          },
          "type": {
            "$ref": "common.schema.json#/$defs/name",
            "description": "Thruster type. A different type replaces the parameters, so give all of them."
          },
          "parameters": {
            "type": "object",
            "description": "Merged over the thruster's parameters (replacing them when the type changes)."
          }
        },
        "required": [
          "parameters"
        ],
        "additionalProperties": false
      },
      "description": "Applied in order to the selected robot pack's thrusters when resolving, so one robot pack serves model variants (e.g. retuned lag or efficiencies). The result is validated like the robot pack; the resolved robot carries it."
    },
    "metadata": {
      "type": "object",
      "description": "Free non-executable annotations preserved verbatim by load/save; never interpreted."
    }
  },
  "required": [
    "kind",
    "id",
    "robot",
    "pool",
    "tasks",
    "seed",
    "timestep_s",
    "sensor_noise",
    "world_frame",
    "task_placements",
    "contacts",
    "initial",
    "run"
  ],
  "additionalProperties": false
}
