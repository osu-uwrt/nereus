{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task include file",
  "description": "Authoritative loader definition: published JSON Schemas and the type registry are generated from this corpus. One task definition in its own task-local frame, composed from generic built-in props, regions, events and declarative scoring. No task, robot or year specific types. Id references (region, prop, asset, frame) are semantic checks.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "task"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "description": {
      "type": "string"
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/named_pose"
      }
    },
    "props": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/prop"
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "scoring": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/name"
          }
        },
        "required": [
          "id",
          "type",
          "parameters"
        ],
        "additionalProperties": false,
        "x-typed": "scoring"
      },
      "description": "Declarative points; stateful rules belong to the pack scoring hook."
    },
    "metadata": {
      "type": "object",
      "description": "Free non-executable annotations preserved verbatim by load/save; never interpreted."
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "frames",
    "props",
    "regions",
    "events",
    "scoring"
  ],
  "additionalProperties": false,
  "$defs": {
    "prop": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/name"
        }
      },
      "required": [
        "id",
        "type",
        "parameters"
      ],
      "additionalProperties": false,
      "description": "rigid_body is added with its first step-4 instance.",
      "x-typed": "prop"
    },
    "region": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/name"
        }
      },
      "required": [
        "id",
        "type",
        "parameters"
      ],
      "additionalProperties": false,
      "description": "box and surface regions are added with their first step-4 instance.",
      "x-typed": "region"
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/name"
        }
      },
      "required": [
        "id",
        "type",
        "parameters"
      ],
      "additionalProperties": false,
      "description": "drop_into, attach, surface and timeout are added with their first step-4 instance.",
      "x-typed": "event"
    }
  }
}
