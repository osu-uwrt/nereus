{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tasks pack",
  "description": "Authoritative loader definition: published JSON Schemas and the type registry are generated from this corpus. Task pack root: task include files, capability requirements, run options and scoring rules. No layout (scenario-owned) and no robot ids.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "tasks"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "description": {
      "type": "string"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/asset"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "common.schema.json#/$defs/path"
          },
          {
            "pattern": "\\.yaml$"
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Pack-relative task include files, each a kind: task document (schema task)."
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "mechanism_type": {
            "enum": [
              "launcher",
              "dropper",
              "claw",
              "magnet"
            ]
          },
          "min_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "task",
          "mechanism_type",
          "min_count"
        ],
        "additionalProperties": false
      },
      "description": "Capability requirements by mechanism type, checked against the selected robot; never by robot id."
    },
    "run_options": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run_option"
      }
    },
    "scoring_rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/scoring_rule"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Free non-executable annotations preserved verbatim by load/save; never interpreted."
    },
    "ui": {
      "type": "object",
      "description": "Viewer/operator presentation data published verbatim in run scores and the scenario description: title, run_options (key,label,type,default,choices[{value,label}]), status_fields, score_fields, focus, previews, run_inspections, manual_adjustment, score_note, actions. Interpreted only by viewers; never by physics or scoring."
    },
    "score_rows": {
      "type": "array",
      "minItems": 1,
      "description": "Fixed, ordered run scorecard rows: score keys the scoring rules write, with their operator labels.",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false
      }
    },
    "outcome_counters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/name"
      },
      "description": "Names counted by the task score feed: every scoring feed event whose result is listed increments that counter."
    },
    "run_messages": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "start",
          "stop",
          "adjustment",
          "reset"
        ]
      },
      "additionalProperties": {
        "type": "string"
      },
      "description": "Operator status texts for run control results."
    }
  },
  "required": [
    "kind",
    "id",
    "tasks",
    "requires",
    "run_options",
    "scoring_rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "run_option": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "type": {
          "enum": [
            "choice",
            "bool"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "default": {
          "type": [
            "string",
            "boolean"
          ]
        }
      },
      "required": [
        "key",
        "type",
        "default"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "choice"
              }
            }
          },
          "then": {
            "required": [
              "choices"
            ],
            "properties": {
              "default": {
                "type": "string"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "choices"
              ]
            },
            "properties": {
              "default": {
                "type": "boolean"
              }
            }
          }
        }
      ],
      "description": "Scenario-selectable option; a choice default must be one of choices (semantic check)."
    },
    "scoring_rule": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "Compiled rules the simulator runs (registered in extensions/rules/registry.cpp)."
        },
        "parameters": {
          "type": "object",
          "description": "Passed to the rules verbatim; the rules validate them."
        }
      },
      "required": [
        "name",
        "parameters"
      ],
      "additionalProperties": false,
      "description": "Competition scoring: named compiled rules and their parameters."
    }
  }
}
