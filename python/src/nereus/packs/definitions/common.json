{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shared pack values",
  "description": "Authoritative loader definition: published JSON Schemas and the type registry are generated from this corpus. Cross-document references (frame names, asset ids, mechanism ids, task ids) are semantic checks, not JSON Schema checks.",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "maxLength": 128,
      "description": "Identifier for ids and native frame names; no path separators or spaces."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z][A-Za-z0-9+.-]*:).+$",
      "description": "Pack-root-relative resource path. Resolve inside the selected pack, never via ROS package paths, URLs or environment variables."
    },
    "pack_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z][A-Za-z0-9+.-]*:).+$",
      "description": "Scenario-folder-relative path selecting another pack folder. Parent segments are permitted only for these selections."
    },
    "vector3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "nonnegative_vector3": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0
      },
      "minItems": 3,
      "maxItems": 3
    },
    "positive_vector3": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 3,
      "maxItems": 3
    },
    "quaternion": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "Child-to-parent unit quaternion, w,x,y,z order. Semantic validation checks the norm."
    },
    "matrix3": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 3,
      "maxItems": 3
    },
    "matrix6": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 6,
        "maxItems": 6
      },
      "minItems": 6,
      "maxItems": 6
    },
    "named_pose": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "position_m": {
          "$ref": "#/$defs/vector3"
        },
        "orientation_wxyz": {
          "$ref": "#/$defs/quaternion"
        }
      },
      "required": [
        "id",
        "position_m",
        "orientation_wxyz"
      ],
      "additionalProperties": false,
      "description": "Named frame fixed in the enclosing task-local frame."
    },
    "yaw_deg": {
      "type": "number",
      "exclusiveMinimum": -360,
      "exclusiveMaximum": 360,
      "description": "Rotation about world +Z in degrees, stored as in the source to avoid hand-rounded radians."
    },
    "frame_ref": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(/[A-Za-z][A-Za-z0-9_]*)?$",
      "maxLength": 257,
      "description": "A scenario frame: world, pool, a task id, an equipment placement id, or <equipment placement id>/<item frame id>."
    },
    "rpy_deg": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "[roll, pitch, yaw] in degrees about x, y, z (applied yaw, then pitch, then roll; R = Rz Ry Rx), as tf2's static_transform_publisher takes them."
    },
    "upright_placement": {
      "type": "object",
      "properties": {
        "relative_to": {
          "$ref": "#/$defs/frame_ref",
          "description": "Frame the pose is measured in; default world."
        },
        "position_m": {
          "$ref": "#/$defs/vector3"
        },
        "yaw_deg": {
          "$ref": "#/$defs/yaw_deg"
        },
        "rpy_deg": {
          "$ref": "#/$defs/rpy_deg"
        }
      },
      "required": [
        "position_m"
      ],
      "additionalProperties": false,
      "description": "Scenario placement: position_m and yaw_deg (or rpy_deg) in `relative_to`. Pools and tasks must end up upright in the world (a semantic check)."
    },
    "frame": {
      "type": "object",
      "properties": {
        "parent": {
          "$ref": "#/$defs/name"
        },
        "child": {
          "$ref": "#/$defs/name"
        },
        "position_m": {
          "$ref": "#/$defs/vector3"
        },
        "orientation_wxyz": {
          "$ref": "#/$defs/quaternion"
        }
      },
      "required": [
        "parent",
        "child",
        "position_m",
        "orientation_wxyz"
      ],
      "additionalProperties": false
    },
    "frames": {
      "type": "object",
      "properties": {
        "root": {
          "$ref": "#/$defs/name"
        },
        "body": {
          "$ref": "#/$defs/name",
          "description": "Frame of the physics body (the centre of mass); defaults to the root."
        },
        "transforms": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/frame"
          },
          "maxItems": 128
        }
      },
      "required": [
        "root",
        "transforms"
      ],
      "additionalProperties": false,
      "description": "One parent per frame, no cycles; all frames resolve to the root. The root is any datum the robot is measured from; resolution re-roots the tree at `body`. ROS names and TF ownership belong to the bridge."
    },
    "collision_box": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "size_m": {
          "$ref": "#/$defs/positive_vector3"
        },
        "center_m": {
          "$ref": "#/$defs/vector3"
        },
        "orientation_wxyz": {
          "$ref": "#/$defs/quaternion"
        }
      },
      "required": [
        "id",
        "size_m",
        "center_m",
        "orientation_wxyz"
      ],
      "additionalProperties": false,
      "description": "Box in the owning document's root frame (robot COM, pool-local, or task-local)."
    },
    "noise3": {
      "type": "object",
      "properties": {
        "bias": {
          "$ref": "#/$defs/vector3"
        },
        "white_stddev": {
          "$ref": "#/$defs/nonnegative_vector3"
        },
        "walk_stddev": {
          "$ref": "#/$defs/nonnegative_vector3"
        }
      },
      "additionalProperties": false
    },
    "noise1": {
      "type": "object",
      "properties": {
        "bias": {
          "type": "number"
        },
        "white_stddev": {
          "type": "number",
          "minimum": 0
        },
        "walk_stddev": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "path": {
          "$ref": "#/$defs/path"
        }
      },
      "required": [
        "id",
        "path"
      ],
      "additionalProperties": false,
      "description": "A file the pack uses, by id and pack-relative path."
    },
    "qos": {
      "type": "object",
      "properties": {
        "history": {
          "const": "keep_last"
        },
        "depth": {
          "type": "integer",
          "minimum": 1
        },
        "reliability": {
          "enum": [
            "reliable",
            "best_effort"
          ]
        },
        "durability": {
          "enum": [
            "volatile",
            "transient_local"
          ]
        }
      },
      "required": [
        "history",
        "depth",
        "reliability",
        "durability"
      ],
      "additionalProperties": false
    }
  }
}
