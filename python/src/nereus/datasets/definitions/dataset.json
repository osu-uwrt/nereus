{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dataset spec",
  "description": "One synthetic dataset: scenarios, label-pack model, image settings, per-task samplers and counts, randomization and splits. Planned into a renderer job by nereus-dataset.",
  "type": "object",
  "properties": {
    "kind": {
      "const": "dataset"
    },
    "id": {
      "$ref": "common.json#/$defs/name"
    },
    "description": {
      "type": "string"
    },
    "labels": {
      "$ref": "common.json#/$defs/pack_path",
      "description": "Label pack folder (with labels.yaml) or file."
    },
    "model": {
      "$ref": "common.json#/$defs/name",
      "description": "Label-pack model: camera, classes and range limit."
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.json#/$defs/pack_path"
      },
      "description": "Scenario folders or files; samples are spread across them round-robin."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "image": {
      "$ref": "#/$defs/image"
    },
    "robot_visuals": {
      "type": "boolean",
      "description": "Draw the robot's own visuals (claw, hull in view)."
    },
    "split": {
      "type": "object",
      "properties": {
        "train": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "val": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "test": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "train",
        "val"
      ],
      "additionalProperties": false,
      "description": "Split fractions; they sum to 1. Images are assigned by a stable hash of the sample name."
    },
    "tasks": {
      "type": "object",
      "propertyNames": {
        "$ref": "common.json#/$defs/name"
      },
      "additionalProperties": {
        "$ref": "#/$defs/block"
      }
    },
    "background": {
      "$ref": "#/$defs/block"
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "min_target_px": {
          "type": "integer",
          "minimum": 0
        },
        "near_m": {
          "type": "number",
          "minimum": 0
        },
        "max_near_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "background_max_labeled_px": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "Overrides of the renderer acceptance defaults (max_range_m always comes from the model)."
    },
    "randomize": {
      "$ref": "#/$defs/randomize"
    },
    "metadata": {
      "$ref": "common.json#/$defs/metadata"
    }
  },
  "required": [
    "kind",
    "id",
    "labels",
    "model",
    "scenarios",
    "seed"
  ],
  "additionalProperties": false,
  "$defs": {
    "image": {
      "type": "object",
      "properties": {
        "resolution_px": {
          "oneOf": [
            {
              "const": "native"
            },
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16384
              },
              "minItems": 2,
              "maxItems": 2
            }
          ],
          "description": "native (the robot pack camera's size) or [width, height]; intrinsics scaled to keep the field of view."
        },
        "crop": {
          "const": "center",
          "description": "Aspect mismatch: scale to cover, crop the center (never stretch)."
        },
        "format": {
          "enum": [
            "jpg",
            "png"
          ]
        },
        "jpeg_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "supersample": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Samples per pixel along each axis, averaged in linear light (anti-aliasing); 1 = off."
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sampler": {
          "$ref": "#/$defs/sampler"
        }
      },
      "required": [
        "count",
        "sampler"
      ],
      "additionalProperties": false
    },
    "frames": {
      "oneOf": [
        {
          "$ref": "common.json#/$defs/name"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.json#/$defs/name"
          }
        }
      ],
      "description": "Target frame: task or a frame id of the task, or a list picked uniformly per attempt."
    },
    "sampler": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "approach",
            "overhead",
            "free"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "approach"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/approach"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "overhead"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/overhead"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "free"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/free"
          }
        }
      ]
    },
    "approach": {
      "type": "object",
      "properties": {
        "type": {
          "const": "approach"
        },
        "frame": {
          "$ref": "#/$defs/frames"
        },
        "offset_m": {
          "$ref": "common.json#/$defs/vector3"
        },
        "facing": {
          "$ref": "common.json#/$defs/vector3"
        },
        "both_sides": {
          "type": "boolean"
        },
        "range_m": {
          "$ref": "common.json#/$defs/nonnegative_range"
        },
        "bearing_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "elevation_deg": {
          "$ref": "common.json#/$defs/range"
        },
        "aim_jitter_deg": {
          "type": "number",
          "minimum": 0
        },
        "max_aim_pitch_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "roll_deg": {
          "type": "number",
          "minimum": 0
        },
        "pitch_deg": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "range_m"
      ],
      "additionalProperties": false
    },
    "overhead": {
      "type": "object",
      "properties": {
        "type": {
          "const": "overhead"
        },
        "frame": {
          "$ref": "#/$defs/frames"
        },
        "offset_m": {
          "$ref": "common.json#/$defs/vector3"
        },
        "altitude_m": {
          "$ref": "common.json#/$defs/nonnegative_range"
        },
        "radius_m": {
          "type": "number",
          "minimum": 0
        },
        "yaw_deg": {
          "type": "number"
        },
        "roll_deg": {
          "type": "number",
          "minimum": 0
        },
        "pitch_deg": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "altitude_m"
      ],
      "additionalProperties": false
    },
    "free": {
      "type": "object",
      "properties": {
        "type": {
          "const": "free"
        },
        "depth_m": {
          "$ref": "common.json#/$defs/nonnegative_range"
        },
        "roll_deg": {
          "type": "number",
          "minimum": 0
        },
        "pitch_deg": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "type",
        "depth_m"
      ],
      "additionalProperties": false
    },
    "value": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "common.json#/$defs/range"
        }
      ],
      "description": "A number is fixed; [low, high] is drawn uniformly per sample."
    },
    "nonnegative_value": {
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "$ref": "common.json#/$defs/nonnegative_range"
        }
      ],
      "description": "A number is fixed; [low, high] is drawn uniformly per sample."
    },
    "water": {
      "type": "object",
      "description": "Pool water optics: *_scale multiply the pool pack's calibrated values; tint_rgb, absorption_per_m_rgb and scattering replace them.",
      "properties": {
        "tint_scale": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "absorption_scale": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "scattering_scale": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "distance_scale_scale": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "tint_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "absorption_per_m_rgb": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "scattering": {
          "$ref": "#/$defs/nonnegative_value"
        }
      },
      "additionalProperties": false
    },
    "lighting": {
      "type": "object",
      "description": "caustics, exposure, sun angles and glare are absolute; *_scale multiply the pool's lights; profile replaces the pool's.",
      "properties": {
        "caustics": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "exposure": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "sun_azimuth_deg": {
          "$ref": "#/$defs/value"
        },
        "sun_elevation_deg": {
          "$ref": "#/$defs/value"
        },
        "glare": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "direct_light_scale": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "ambient_light_scale": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "profile": {
          "enum": [
            "indoor",
            "outdoor"
          ]
        }
      },
      "additionalProperties": false
    },
    "image_effects": {
      "type": "object",
      "properties": {
        "noise_sigma": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "blur_px": {
          "$ref": "#/$defs/nonnegative_value"
        }
      },
      "additionalProperties": false,
      "description": "Gaussian RGB noise sigma (8-bit units) and blur sigma (px); 0 = off."
    },
    "environment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "maxLength": 64
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "description": "Relative share in weighted mode (default 1); 0 drops the environment."
        },
        "water": {
          "$ref": "#/$defs/water"
        },
        "lighting": {
          "$ref": "#/$defs/lighting"
        },
        "image": {
          "$ref": "#/$defs/image_effects"
        },
        "time_s": {
          "$ref": "#/$defs/nonnegative_value"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "description": "One named appearance: laid over the base randomization."
    },
    "environments": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "weighted",
            "sweep"
          ],
          "description": "weighted (default): picked per sample by weight; sweep: cycled evenly within each task block."
        },
        "list": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/environment"
          }
        },
        "sweep": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^((water|lighting|image)\\.[a-z_]+|time_s)$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1
          },
          "description": "Cartesian grid of fixed values (keys group.key), crossed with every list entry."
        }
      },
      "additionalProperties": false
    },
    "randomize": {
      "type": "object",
      "description": "Per-sample randomization. water / lighting / image / time_s are the base every environment inherits (omitted keys take the defaults).",
      "properties": {
        "water": {
          "$ref": "#/$defs/water"
        },
        "lighting": {
          "$ref": "#/$defs/lighting"
        },
        "image": {
          "$ref": "#/$defs/image_effects"
        },
        "time_s": {
          "$ref": "#/$defs/nonnegative_value"
        },
        "placement": {
          "type": "object",
          "properties": {
            "task_yaw_deg": {
              "type": "number",
              "minimum": 0
            },
            "task_offset_m": {
              "type": "number",
              "minimum": 0
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "common.json#/$defs/name"
                }
              },
              "description": "Task ids that share one placement jitter (moved rigidly together), e.g. [[surface, table]]."
            }
          },
          "additionalProperties": false
        },
        "indicators": {
          "type": "object",
          "properties": {
            "latched_probability": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "environments": {
          "$ref": "#/$defs/environments"
        }
      },
      "additionalProperties": false
    }
  }
}
