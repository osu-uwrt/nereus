{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pool pack",
  "description": "Authoritative loader definition: published JSON Schemas and the type registry are generated from this corpus. Pool-local geometry and water only: no robot, task or course layout.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "pool"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/name"
    },
    "description": {
      "type": "string"
    },
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/asset"
      }
    },
    "collision_boxes": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/collision_box"
      },
      "minItems": 1,
      "description": "Static contact boxes in pool-local coordinates."
    },
    "water_optics": {
      "$ref": "types.schema.json#/$defs/water_optics"
    },
    "pending": {
      "$ref": "common.schema.json#/$defs/pending"
    },
    "metadata": {
      "type": "object",
      "description": "Free non-executable annotations preserved verbatim by load/save; never interpreted."
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "assets",
    "type",
    "parameters",
    "collision_boxes"
  ],
  "additionalProperties": false,
  "x-typed": "pool"
}
