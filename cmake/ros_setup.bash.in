# Generated by cmake/NereusRosIndex.cmake: puts this build's `nereus` ROS package on AMENT_PREFIX_PATH so
# `ros2 launch nereus sim.launch.py` works from any directory. Source it after your ROS 2 setup.
_nereus_prefix="@NEREUS_ROS_PREFIX@"
case ":${AMENT_PREFIX_PATH:-}:" in
    *":${_nereus_prefix}:"*) ;;
    *) export AMENT_PREFIX_PATH="${_nereus_prefix}${AMENT_PREFIX_PATH:+:${AMENT_PREFIX_PATH}}" ;;
esac
unset _nereus_prefix
