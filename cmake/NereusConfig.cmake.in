@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.3 NO_MODULE)
if(@NEREUS_BUILD_CAMERAS@)
  find_dependency(OpenCV 4 COMPONENTS core imgproc imgcodecs)
endif()
if(@NEREUS_BUILD_VISUALIZATION@ OR @NEREUS_BUILD_VIEWER@ OR @NEREUS_BUILD_SIMULATION_VIEW@)
  find_dependency(Threads)
endif()
if(@NEREUS_NEEDS_YAML@)
  find_dependency(yaml-cpp CONFIG)
endif()
if(@NEREUS_BUILD_VIEWER@ OR @NEREUS_BUILD_SCENE_RENDERER@)
  find_dependency(OpenGL)
  find_dependency(GLEW)
endif()
if(@NEREUS_BUILD_MESH_ASSETS@ OR @NEREUS_BUILD_SCENE_RENDERER@)
  find_dependency(assimp 5 CONFIG)
endif()
if(@NEREUS_BUILD_SCENE_RENDERER@)
  find_dependency(PNG)
endif()
if(@NEREUS_BUILD_OFFSCREEN_RENDERER@)
  find_dependency(OpenGL COMPONENTS EGL)
  find_dependency(Threads)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NereusTargets.cmake")
check_required_components(Nereus)
