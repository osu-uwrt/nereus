@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Eigen3 3.3 NO_MODULE)
if(@RP_BUILD_CAMERAS@)
  find_dependency(OpenCV 4 COMPONENTS core imgproc imgcodecs)
endif()
if(@RP_BUILD_VISUALIZATION@ OR @RP_BUILD_VIEWER@ OR @RP_BUILD_SIMULATION_VIEW@)
  find_dependency(Threads)
endif()
if(@RP_NEEDS_YAML@)
  find_dependency(yaml-cpp CONFIG)
endif()
if(@RP_BUILD_VIEWER@ OR @RP_BUILD_SCENE_RENDERER@)
  find_dependency(OpenGL)
  find_dependency(GLEW)
endif()
if(@RP_BUILD_MESH_ASSETS@ OR @RP_BUILD_SCENE_RENDERER@)
  find_dependency(assimp 5 CONFIG)
endif()
if(@RP_BUILD_SCENE_RENDERER@)
  find_dependency(PNG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/RoboticsPlatformTargets.cmake")
check_required_components(RoboticsPlatform)
